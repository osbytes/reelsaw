# ---- required ----
# 32+ random chars: openssl rand -base64 32
# Signs sessions and encrypts the provider API keys admins enter in Settings → Models (rotate it and those keys must be entered again)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# public URL users open in the browser (used for auth cookies / CORS)
APP_URL=http://localhost:3000

# ---- AI models (provider:model). Any provider supported by the AI SDK. ----
# Language model used to pick clips (the default; admins can switch models at runtime under Settings → System → Models):
#   openai:gpt-4o-mini | anthropic:claude-sonnet-4-5 | google:gemini-2.5-flash
#   groq:llama-3.3-70b-versatile | gateway:anthropic/claude-sonnet-4-5 | compat:<model> (any OpenAI-compatible server)
AI_MODEL=openai:gpt-4o-mini
# Transcription model (must return word timestamps; openai:gpt-4o-transcribe does not):
#   openai:whisper-1 | gateway:openai/whisper-1 | deepgram:nova-3 | assemblyai:best | groq:whisper-large-v3-turbo
#   gateway:openai/whisper-1 | gateway:openai/gpt-4o-transcribe (Vercel AI Gateway; vendor options still apply)
TRANSCRIPTION_MODEL=openai:whisper-1

# Provider keys: set the ones you use
OPENAI_API_KEY=
# Point OpenAI at a local OpenAI-compatible server (e.g. Speaches / faster-whisper-server, LM Studio, vLLM):
# OPENAI_BASE_URL=http://speaches:8000/v1
# OPENAI_API_MODE=chat      # responses (OpenAI default) | chat. Defaults to chat whenever OPENAI_BASE_URL is set
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
# Vercel AI Gateway: one key for every cloud vendor as "gateway:<vendor>/<model>", list-price tokens, no markup,
# per-request cost in eval reports. Key: Vercel dashboard → AI Gateway → API keys (or `vercel ai-gateway`).
AI_GATEWAY_API_KEY=
# Generic OpenAI-compatible chat provider, addressed as "compat:<model>" (name configurable):
# OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
# OPENAI_COMPATIBLE_API_KEY=ollama
# OPENAI_COMPATIBLE_NAME=compat

# ---- Fully local (docker compose --profile local-ai up -d): Ollama for the LLM, Speaches (whisper) for STT ----
# AI_MODEL=compat:llama3.1:8b
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1   # native Ollama (macOS); http://ollama:11434/v1 with --profile ollama
# OPENAI_COMPATIBLE_API_KEY=ollama
# TRANSCRIPTION_MODEL=openai:Systran/faster-whisper-small
# OPENAI_BASE_URL=http://speaches:8000/v1
# OPENAI_API_KEY=local
# WHISPER_MODEL=Systran/faster-whisper-small   # or Systran/faster-whisper-large-v3 on a GPU

# ---- clip selection (see README "Research-backed clip selection") ----
# ANALYZE_SCORE_RULE=relative        # relative: drop below max(FLOOR, median − K·MAD) of the run; absolute: fixed 45
# ANALYZE_MIN_SCORE_FLOOR=25
# ANALYZE_SCORE_MAD_K=1
# ANALYZE_PAIRWISE_PASSES=3          # sliding passes over the top 10; 3 passes = 48 judge calls, 1 = 18
# ANALYZE_JUDGE_MODEL=anthropic:claude-sonnet-4-5   # scores/compares candidates; default: the language model

# ---- storage: local (default, inside the /data volume) or s3 ----
STORAGE_DRIVER=local
# S3_BUCKET=reelsaw
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000          # MinIO / R2 / B2 / etc. Leave empty for AWS
# S3_FORCE_PATH_STYLE=true               # required for MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=reelsaw                    # optional key prefix
# S3_PUBLIC_URL=https://cdn.example.com  # optional: serve clips from a public bucket/CDN instead of presigned URLs
# S3_PRESIGN_EXPIRES=3600

# ---- behaviour ----
ALLOW_SIGNUP=true            # set false after creating your account
# RENDER_CONCURRENCY=auto     # parallel renders per worker: auto follows CPUs and free memory; a number pins it
TRANSCRIBE_CHUNK_SECONDS=600 # audio is chunked for transcription APIs with upload limits
MAX_UPLOAD_MB=4096
# MAX_SOURCE_FILE_MB=8192      # largest file yt-dlp may download for a link source
# ALLOW_PRIVATE_SOURCE_URLS=false  # true lets link sources point at LAN/loopback hosts (a NAS); off blocks them (SSRF guard)
CLEANUP_WORKDIR=true         # delete audio/chunks/subtitle intermediates when a project finishes
# Automatic layout: faces → follow crop, webcam-in-corner → stacked, none → fit. Model ships in the image; for local dev run `pnpm models:download`.
# FACE_DETECTION=true
# FACE_MODEL_PATH=apps/server/models/ultraface-rfb-320.onnx
# LAYOUT_MIN_FACE_RATIO=0.6
# LAYOUT_MIN_FACE_SIZE=0.18
# Resource governor: heavy steps wait while the host is over these limits.
# Node stdlib only (works on Linux, macOS, Windows; container limits honoured via libuv).
# MAX_CPU_PERCENT=90           # % of total CPU time busy, measured between samples
# MIN_FREE_MEM_MB=512
# MIN_FREE_DISK_MB=2048        # below this, jobs fail fast with a "low disk" error instead of corrupting output
# RESOURCE_WAIT_MAX_SECONDS=900
# RUN_WORKERS_IN_APP=false   # set false if you only want dedicated `worker` containers to process jobs
# POSTGRES_PASSWORD=reelsaw
# PORT=3000

# ---- logging ----
# LOG_LEVEL=info                       # a level: trace|debug|info|warn|error|fatal|silent
# LOG_LEVEL=info,render=debug,http=warn  # a global level plus per-module overrides (module = the `module` field)
#   change it without a restart:  reelsaw log-level render=debug --for 15m   (Settings -> System -> Log level)
# LOG_FORMAT=auto                      # auto (pretty on a terminal) | json | pretty
# LOG_FILE=/data/logs/reelsaw.log      # also write JSON lines here, daily files, 7 kept (reelsaw logs <id>, issue reports)

# ---- observability (optional) ----
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=reelsaw
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # OTLP over HTTP/protobuf (traces + metrics)
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20xxx
# OTEL_METRICS_ENABLED=true
# OTEL_METRIC_EXPORT_INTERVAL=30000
# OTEL_LOG_LEVEL=info

# Burned-in caption / watermark detection in the source (PP-OCRv4 text detector, CPU).
# Found text is kept out of speaker crops and blurred elsewhere (per project: "source text: hide").
# TEXT_DETECTION=true
# TEXT_MODEL_PATH=apps/server/models/ppocrv4-det.onnx

# On-device audio models (CPU). `pnpm models:download` fetches them for runs outside Docker.
# VAD=true                       # Silero VAD: shortens long pauses (project setting "Pauses")
# VAD_MODEL_PATH=apps/server/models/silero-vad.onnx
# ALIGNER=true                   # wav2vec2 CTC forced alignment: exact word boundaries for filler cuts
# ALIGN_MODEL_DIR=apps/server/models/wav2vec2-base-960h
# ASR_CACHE_DAYS=14              # speech-to-text results cache under DATA_DIR/cache/asr

# LLM call capture: none | logs | langfuse (comma-separated for several)
#   logs:     one structured log line per call (prompt, response, tokens, latency); truncated to LLM_TRACE_MAX_CHARS
#   langfuse: a trace per job, a generation per call; keys are checked at boot
# LLM_TRACE=none
# LLM_TRACE_MAX_CHARS=4000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
