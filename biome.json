{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "apps/**/*.{ts,tsx,js,mjs,cjs}",
      "packages/**/*.{ts,tsx,js,mjs,cjs}",
      "scripts/**/*.{ts,js,mjs,cjs}",
      "website/**/*.{ts,tsx,js,mjs,cjs}",
      "!**/dist",
      "!**/dist-bundle",
      "!website/.next",
      "!website/next-env.d.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineEnding": "lf", "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "jsxQuoteStyle": "double", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "always" }
  },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useExponentiationOperator": "error"
      },
      "complexity": {
        "noCommaOperator": "off",
        "useOptionalChain": "error",
        "useLiteralKeys": "off",
        "noUselessFragments": "error",
        "noUselessEscapeInRegex": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "off",
        "useIterableCallbackReturn": "off",
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "nursery": {
        "useExhaustiveSwitchCases": "error"
      },
      "a11y": {
        "useButtonType": "warn",
        "noStaticElementInteractions": "warn",
        "noLabelWithoutControl": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "noAutofocus": "warn",
        "useMediaCaption": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useValidAnchor": "warn",
        "noSvgWithoutTitle": "warn"
      }
    }
  }
}
