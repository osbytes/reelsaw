{
  "name": "reelsaw",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "predev": "pnpm --filter @reelsaw/shared build",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @reelsaw/shared build && pnpm -r typecheck",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "clones": "node scripts/clones.mjs",
    "guards": "node scripts/check-agent-files.mjs && node scripts/dup-ledger.mjs --check && node scripts/lint-ratchet.mjs",
    "format": "biome format --write",
    "db:generate": "pnpm --filter @reelsaw/server db:generate",
    "start": "pnpm --filter @reelsaw/server start",
    "mock-ai": "node scripts/mock-ai.mjs",
    "docs:gen": "pnpm --filter @reelsaw/server docs:gen",
    "docs:check": "pnpm --filter @reelsaw/server docs:check",
    "languages:check": "node packages/shared/scripts/whisper-languages.mjs --check && node packages/shared/scripts/language-data.mjs --check",
    "eval": "pnpm --filter @reelsaw/server eval",
    "models:download": "sh scripts/download-models.sh apps/server/models",
    "changeset": "changeset",
    "release:tag": "sh scripts/release-tag.sh",
    "release:version": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@total-typescript/ts-reset": "0.6.1",
    "jscpd": "5.4.3",
    "knip": "5.88.1",
    "lefthook": "2.2.2",
    "typescript": "5.9.3"
  }
}
