{
  "name": "@reelsaw/server",
  "version": "0.27.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "npx @better-auth/cli@latest generate --config src/auth.ts --output src/db/auth-schema.ts",
    "eval:transcription": "tsx src/eval/transcription.ts",
    "cli": "tsx src/cli.ts",
    "eval": "tsx src/eval/run.ts",
    "eval:cuts": "tsx src/eval/run.ts cuts",
    "bench:e2e": "tsx src/eval/e2e.ts",
    "bundle": "node scripts/bundle.mjs",
    "test": "node --import tsx --test --test-concurrency=2 test/*.test.ts",
    "test:unit": "node scripts/unit-tests.mjs",
    "eval:offline": "tsx src/eval/run.ts --offline",
    "creator-spans": "tsx src/eval/tools/creator-spans.ts",
    "models:download": "sh ../../scripts/download-models.sh models",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "docs:check": "tsx scripts/gen-docs.ts --check",
    "stripe:setup": "pnpm --filter @reelsaw/shared build && tsx scripts/stripe-setup.ts",
    "stripe:mock": "tsx test/stripe-mock.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/assemblyai": "^3.0.67",
    "@ai-sdk/deepgram": "^3.1.38",
    "@ai-sdk/gateway": "^4.0.123",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/groq": "^4.0.69",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@ai-sdk/provider": "^4.0.33",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@better-auth/api-key": "1.7.10",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@hono/mcp": "0.3.2",
    "@hono/node-server": "^2.1.5",
    "@hono/trpc-server": "^0.4.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@reelsaw/shared": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "@sentry/node": "^11.8.0",
    "@trpc/server": "11.19.0",
    "ai": "^7.0.150",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.12",
    "cockatiel": "^3.2.1",
    "disposable-email-domains": "1.0.62",
    "drizzle-orm": "^0.45.4",
    "fuse.js": "7.1.0",
    "hono": "^4.13.13",
    "langfuse": "3.39.2",
    "nodemailer": "^10.2.1",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "posthog-node": "^5.57.0",
    "semver": "^7.8.5",
    "stripe": "23.0.0",
    "undici": "7.30.1",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  }
}
