# https://editorconfig.org — what editors should write. .gitattributes enforces the line endings on commit.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# generated or vendored: keep them byte-for-byte as their tools write them
[{apps/server/drizzle/meta/**,eval/**,**/*.svg,pnpm-lock.yaml}]
insert_final_newline = unset
trim_trailing_whitespace = unset
