# Public URL of the site; used for canonical links, Open Graph tags, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://reelsaw.com

# Analytics are optional. Leave NEXT_PUBLIC_POSTHOG_KEY empty and nothing is loaded or proxied.
# When set, posthog-js loads and sends events through this site at /ingest (a reverse proxy to
# PostHog defined in next.config.ts), so ad blockers that block posthog.com do not see it.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host: https://us.i.posthog.com (default), https://eu.i.posthog.com, or your own.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

