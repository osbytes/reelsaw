{
  "name": "reelsaw-website",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "reelsaw.com: the website for the Reelsaw open-source project",
  "scripts": {
    "dev": "pnpm i18n:compile && next dev -p 3200",
    "build": "pnpm i18n:compile && next build",
    "start": "next start -p 3200",
    "typecheck": "pnpm i18n:compile && next typegen && tsc --noEmit -p tsconfig.json",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui check sync",
    "i18n:compile": "lingui compile --typescript --namespace es",
    "render:film": "node scripts/render-pipeline-film.mjs"
  },
  "dependencies": {
    "@lingui/core": "6.12.0",
    "@lingui/message-utils": "6.12.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "lucide-react": "^1.60.0",
    "next": "^16.4.5",
    "posthog-js": "^1.438.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}
