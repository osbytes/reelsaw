# Copy to .env and fill in. Restart after changes: docker compose up -d
# Every variable Reelsaw reads is listed below with its default and meaning (the same list, as a
# table, is docs/CONFIG.md in the repository). Uncommented lines are the ones to review for a hosted
# install; commented lines show the default. The part between the generated markers is rewritten by
# `pnpm docs:gen`; keep hand-written notes up here.
#
# Required: BETTER_AUTH_SECRET (openssl rand -base64 32), POSTGRES_PASSWORD, and a key for one
# model provider, or the fully local preset below.

# ---- Fully local preset (docker compose --profile local-ai up -d) ----
# Replace the values of the same names below:
#   AI_MODEL=compat:qwen2.5:14b            # qwen2.5:7b or gemma3:4b on less RAM; install.sh picks by RAM
#   OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the host (macOS); http://ollama:11434/v1 with --profile ollama
#   OPENAI_COMPATIBLE_API_KEY=ollama
#   TRANSCRIPTION_MODEL=openai:Systran/faster-whisper-small
#   OPENAI_BASE_URL=http://speaches:8000/v1
#   OPENAI_API_KEY=local
#   WHISPER_MODEL=Systran/faster-whisper-small   # faster-whisper-large-v3 on a GPU
# With an NVIDIA GPU (driver + NVIDIA Container Toolkit on the host), also:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml   # Windows: use ; between paths (colon is the drive letter)
#   SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cuda
#   WHISPER_MODEL=Systran/faster-whisper-large-v3

# >>> generated:env (pnpm docs:gen; edit apps/server/scripts/docs-meta.ts, not this block)
# ---- Core ----
# Port the HTTP server listens on.
# PORT=3000
# Public URL people open in the browser; used for auth cookies, CORS, the OAuth issuer and links in emails.
APP_URL=http://localhost:3000
# Ask GitHub for the latest release and tell admins in Settings → System, reelsaw version and the check_for_update tool when a newer one exists. Only the request leaves the machine (no ids, no usage). false never contacts GitHub. Runtime setting: admins can change it under Settings → System without a restart.
# UPDATE_CHECK=true
# Releases endpoint the check asks (GitHub's releases/latest of this repository); change it for a fork or a mirror.
# UPDATE_CHECK_URL=https://api.github.com/repos/osbytes/reelsaw/releases/latest
# Hours between update checks (1–168). "Check now" in Settings asks at most once a minute.
# UPDATE_CHECK_HOURS=6
# Connections in each process's Postgres pool (minimum 4). The app and every worker process hold their own, so keep (processes x this) under Postgres' max_connections. Raise it if the boot log warns that job concurrency exceeds the pool. Model-call slots use a separate small pool, and connections time out after 10 s to connect and 5 minutes idle inside a transaction.
# DB_POOL_MAX=10
# 32+ random characters (openssl rand -base64 32). Signs sessions and encrypts the provider keys admins enter in Settings; rotating it makes those keys unreadable.
BETTER_AUTH_SECRET=
# Stable name for this process on Settings → System → Workers. Unset: hostname:pid. Set it to the pod or container name when scaling workers so each replica stays recognisable. Two live processes must not share an id (they would overwrite each other's heartbeat and disk leases): if a process with the same id beat in the last 30 s, the new one appends - and four hex characters and logs a warning, so a pinned id on docker compose --scale worker=N still works.
# WORKER_ID=
# Largest accepted file upload in MB. Runtime setting: admins can change it under Settings → System without a restart.
MAX_UPLOAD_MB=4096
# Largest file yt-dlp may download for a link source, in MB (--max-filesize). Runtime setting: admins can change it under Settings → System without a restart.
# MAX_SOURCE_FILE_MB=8192
# true lets link sources point at LAN or loopback hosts (a NAS). Off, they are blocked (SSRF guard). The guard checks the first address only: yt-dlp follows redirects itself, so a shared or hosted instance also needs an egress proxy or network policy (see SECURITY.md, "URL sources and your network"). Runtime setting: admins can change it under Settings → System without a restart.
# ALLOW_PRIVATE_SOURCE_URLS=false
# Reelsaw catalog manifest (sounds, icons, stickers for the Library's Browse panel), fetched hourly with ETag; the starter pack bundled in the image is used until a newer version arrives. Runtime setting: admins can change it under Settings → System without a restart.
# CATALOG_URL=https://reelsaw.com/catalog/v1/index.json

# ---- Accounts and sign-up ----
# open: anyone may sign up. approval: new accounts wait for an admin (a private box). closed: no sign-ups. The first account is always the admin. Unset: open, unless the deprecated ALLOW_SIGNUP says otherwise. A public instance with email confirmation, captcha and quotas should stay open. Runtime setting: admins can change it under Settings → System without a restart. (open | approval | closed)
SIGNUP_MODE=open
# Outgoing mail for approval notices, password resets and verification: none, smtp or resend. none leaves those features off. (none | smtp | resend)
EMAIL_DRIVER=none
# Sender, e.g. Reelsaw <no-reply@example.com>. Required with an email driver.
EMAIL_FROM=
# SMTP connection, e.g. smtps://user:pass@smtp.example.com:465. Required with EMAIL_DRIVER=smtp.
SMTP_URL=
# Required with EMAIL_DRIVER=resend.
RESEND_API_KEY=
# With an email driver: users must click the verification link before they can sign in. The link works for 24 hours and is single-use; an expired one offers a new send. Runtime setting: admins can change it under Settings → System without a restart.
REQUIRE_EMAIL_VERIFICATION=false
# Take the client address from the reverse proxy's header (see TRUSTED_PROXY_HEADER): the Docker deployment sits behind Caddy, so the default is on. false when the app is exposed directly, or the header is whatever the client sent. The address feeds the sign-up cap and the OAuth client-registration limit.
# TRUST_PROXY=true
# With x-forwarded-for: how many trusted proxies sit in front of the app, each appending the address it saw. The client is the entry that many places from the right, so entries a client prepends are ignored. 1 for Caddy alone, 2 for Cloudflare in front of Caddy.
# TRUSTED_PROXY_HOPS=1
# Header that carries the client address when TRUST_PROXY is on: x-forwarded-for (default; Caddy, nginx, most load balancers), cf-connecting-ip (Cloudflare, with the origin closed to everything else) or x-real-ip. Only the selected header is read, so a client cannot choose its address by sending a different one. (x-forwarded-for | cf-connecting-ip | x-real-ip)
# TRUSTED_PROXY_HEADER=x-forwarded-for
# Accounts one network address may create per day (sign-up guard). 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
# MAX_SIGNUPS_PER_IP_PER_DAY=0
# Refuse sign-ups from known temporary-address domains. Runtime setting: admins can change it under Settings → System without a restart.
# BLOCK_DISPOSABLE_EMAILS=false
# Terms of service link shown on the sign-up form when set. Runtime setting: admins can change it under Settings → System without a restart.
TERMS_URL=
# Privacy policy link shown on the sign-up form when set. Runtime setting: admins can change it under Settings → System without a restart.
PRIVACY_URL=
# Bot protection on sign-up, sign-in and password reset: cloudflare-turnstile, google-recaptcha or hcaptcha. Needs both keys below. Runtime setting: admins can change it under Settings → System without a restart. (cloudflare-turnstile | google-recaptcha | hcaptcha)
CAPTCHA_PROVIDER=
# Public captcha key. Runtime setting: admins can change it under Settings → System without a restart.
CAPTCHA_SITE_KEY=
# Secret captcha key. Runtime setting: admins can change it under Settings → System without a restart.
CAPTCHA_SECRET_KEY=
# MCP over OAuth 2.1 so claude.ai and Claude Desktop connectors sign in with the browser. API keys always work.
MCP_OAUTH=false
# Include machine numbers in GET /api/health for anonymous callers (private networks only). Admins always get them. Runtime setting: admins can change it under Settings → System without a restart.
HEALTH_DETAILS=false

# ---- Models ----
# Default language model as provider:model (openai:gpt-4o-mini, anthropic:claude-sonnet-4-5, google:gemini-2.5-flash, groq:llama-3.3-70b-versatile, gateway:anthropic/claude-sonnet-4-5, compat:<model>). Admins can override it at runtime under Settings -> System -> Models.
AI_MODEL=openai:gpt-4o-mini
# Default speech-to-text model as provider:model. It must return word timestamps: openai:whisper-1, deepgram:nova-3, assemblyai:best, groq:whisper-large-v3-turbo, gateway:openai/whisper-1, or a Speaches model through OPENAI_BASE_URL. openai:gpt-4o-transcribe returns none and does not work.
TRANSCRIPTION_MODEL=openai:whisper-1
# Model that re-aligns cut boundaries on short windows. Unset: TRANSCRIPTION_MODEL. A bigger whisper here is cheap and pays off.
# TRANSCRIPT_ALIGN_MODEL=

# ---- Provider keys ----
# OpenAI key. With OPENAI_BASE_URL it is the key for that server (local for Speaches).
OPENAI_API_KEY=
# Point the OpenAI provider at a local OpenAI-compatible server (Speaches, LM Studio, vLLM), e.g. http://speaches:8000/v1.
# OPENAI_BASE_URL=
# responses (OpenAI default) or chat. Defaults to chat whenever OPENAI_BASE_URL is set. (responses | chat)
# OPENAI_API_MODE=
# Anthropic key (language model only; Anthropic has no speech-to-text).
ANTHROPIC_API_KEY=
# Google Gemini key.
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq key (language and transcription models).
GROQ_API_KEY=
# Deepgram key (transcription).
DEEPGRAM_API_KEY=
# AssemblyAI key (transcription).
ASSEMBLYAI_API_KEY=
# Vercel AI Gateway: one key for every cloud vendor as gateway:<vendor>/<model>, list-price tokens, per-request cost in eval reports.
AI_GATEWAY_API_KEY=
# Alternative to AI_GATEWAY_API_KEY on Vercel-hosted deployments (injected by the platform).
# VERCEL_OIDC_TOKEN=
# Generic OpenAI-compatible chat server, addressed as compat:<model> (Ollama: http://host.docker.internal:11434/v1).
# OPENAI_COMPATIBLE_BASE_URL=
# Key for the compat server (ollama for Ollama).
# OPENAI_COMPATIBLE_API_KEY=
# Provider prefix used for the compat server, i.e. the compat in compat:<model>.
# OPENAI_COMPATIBLE_NAME=compat
# Ask the compat server for response_format: json_schema. Set false for servers that choke on it; parsing falls back to lenient.
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUTS=true
# Pexels key (free): stock photos and portrait videos in Library → Browse. Empty = hidden. Runtime setting: admins can change it under Settings → System without a restart.
PEXELS_API_KEY=
# Pixabay key (free): photos, illustrations, vectors and videos in Library → Browse. Results are cached 24 h; files are downloaded, never hotlinked. Empty = hidden. Runtime setting: admins can change it under Settings → System without a restart.
PIXABAY_API_KEY=
# Freesound key (free): CC0 (or CC-BY) sound effects in Library → Browse. Empty = hidden. Runtime setting: admins can change it under Settings → System without a restart.
FREESOUND_API_KEY=
# Giphy key: GIFs and stickers in Library → Browse (shows "Powered by GIPHY"). Empty = hidden. Runtime setting: admins can change it under Settings → System without a restart.
GIPHY_API_KEY=
# Klipy key: GIF search in Library → Browse (experimental). Empty = hidden. Runtime setting: admins can change it under Settings → System without a restart.
KLIPY_API_KEY=
# Iconify API for icon search (permissive sets only: lucide, tabler, mdi, ph, heroicons, ri, solar); point it at a self-hosted instance if you prefer. https only. Runtime setting: admins can change it under Settings → System without a restart.
# ICONIFY_API_URL=https://api.iconify.design
# Show Openverse (CC0 and CC-BY images and audio, no key) in Library → Browse. Runtime setting: admins can change it under Settings → System without a restart.
# OPENVERSE_ENABLED=false

# ---- Pipeline tuning ----
# Parallel renders per worker. auto follows CPUs and free memory (see the resource governor); a number pins it.
# RENDER_CONCURRENCY=auto
# Audio is split into chunks of this length for transcription APIs with upload limits.
# TRANSCRIBE_CHUNK_SECONDS=600
# Parallel chunk transcriptions. 0 = auto: 1 for a self-hosted OPENAI_BASE_URL, 3 for cloud vendors.
# TRANSCRIBE_CONCURRENCY=0
# Parallel LLM calls while finding and scoring moments. 0 = auto: 1 for a self-hosted model, 4 for cloud.
# ANALYZE_CONCURRENCY=0
# Longest one model call may take (all its HTTP attempts together) before the step is stopped and retried. 0 = auto: 120 s for a hosted model, 600 s for a self-hosted one (Ollama, a compatible server), and for a self-hosted transcription at least twice the chunk's audio length. Time spent waiting for a provider slot (PROVIDER_CONCURRENCY) does not count. A slow CPU-only model may need more. Runtime setting: admins can change it under Settings → System without a restart.
# LLM_CALL_TIMEOUT_SECONDS=0
# A stage made of checkpointed steps (finding moments) is stopped when no step has finished for this long; Retry continues where it stopped. 0 = auto: 1.5 times the model call timeout. Runtime setting: admins can change it under Settings → System without a restart.
# STAGE_IDLE_TIMEOUT_MINUTES=0
# Model calls in flight per provider across every app and worker process, e.g. compat=2,openai=2 (compat = the compatible provider's name). Unset providers: 2 for a self-hosted compatible server, 1 for openai with OPENAI_BASE_URL (a local whisper uses every core per call), unlimited for cloud. Time a call waits here does not count against its time limit.
# PROVIDER_CONCURRENCY=
# Rubric samples per candidate (the median is kept). 0 = auto: 1 self-hosted, 3 cloud.
# ANALYZE_SCORE_SAMPLES=0
# Pairwise re-ranking of the top clips with position swapping. auto = on for cloud models only. (auto | on | off)
# ANALYZE_PAIRWISE=auto
# Sliding pairwise passes over the top 10 candidates. 3 passes = 48 judge calls, 1 = 18.
# ANALYZE_PAIRWISE_PASSES=3
# How auto mode drops weak picks. relative: below max(ANALYZE_MIN_SCORE_FLOOR, median - ANALYZE_SCORE_MAD_K x MAD) of the run's scores, so it holds across judges. absolute: the old fixed cutoff of 45. The best clip is always kept. (relative | absolute)
# ANALYZE_SCORE_RULE=relative
# With the relative rule: never keep a clip whose rubric total is below this (25 means the judge called it unpostable).
# ANALYZE_MIN_SCORE_FLOOR=25
# With the relative rule: how many median absolute deviations below the median still count as a keeper.
# ANALYZE_SCORE_MAD_K=1
# Model that scores and compares candidates, as provider:model (e.g. anthropic:claude-sonnet-4-5). Unset: the language model.
# ANALYZE_JUDGE_MODEL=
# Feed entities from the video metadata (channel, title, description, tags) and the project's "Names & terms" to the transcriber as vocabulary hints. Set false and those per-project hints are silently ignored.
# TRANSCRIPT_BIAS=true
# After transcription, let the language model fix misheard entity names (constrained to fuzzy matches). On by default. Instance ceiling: off skips it for every project; when on, a project may opt out via refineEntities. Runtime setting: admins can change it under Settings → System without a restart.
# TRANSCRIPT_CORRECTION=true
# Detect fillers, repetitions and false starts and cut them from captions. Off by default. Instance ceiling: projects opt in via refineDisfluency when this is on. Runtime setting: admins can change it under Settings → System without a restart.
# DISFLUENCY_REMOVAL=false
# Add a model pass to the rule-based disfluency pass. Off by default. Instance ceiling: projects opt in via disfluencyLlm when this is on. Runtime setting: admins can change it under Settings → System without a restart.
# DISFLUENCY_LLM=false
# Scan the whole video for on-screen text (burned-in captions, watermarks, slides) during refine, so captions avoid it and slides are shown whole. On by default. Instance ceiling: off skips it for every project; when on, a project may opt out via refineScenes. Shot cuts do not depend on it: every project detects them before clip selection. Runtime setting: admins can change it under Settings → System without a restart.
# REFINE_SCENES=true
# Corrections at or above this model confidence are applied automatically; the rest wait for the user.
# TRANSCRIPT_AUTO_FIX_CONFIDENCE=0.85
# Face detection for automatic layout (follow crop, stacked webcam). false = fit only.
# FACE_DETECTION=true
# Share of sampled frames that must contain a face before a clip gets a face-following layout.
# LAYOUT_MIN_FACE_RATIO=0.6
# Median face height / frame height needed for a face-following layout.
# LAYOUT_MIN_FACE_SIZE=0.18

# ---- On-device models (face, text, voice, alignment) ----
# Speech-to-text results cache under DATA_DIR/cache/asr (and under cache/asr/ in the bucket with STORAGE_DRIVER=s3, shared by every host); entries older than this are pruned at boot and by the hourly sweep.
# ASR_CACHE_DAYS=14
# UltraFace ONNX model. Ships in the image; pnpm models:download fetches it for runs outside Docker.
# FACE_MODEL_PATH=./models/ultraface-rfb-320.onnx
# Burned-in caption and watermark detection (PP-OCRv4, CPU). false = never hide source text.
# TEXT_DETECTION=true
# Silero voice activity detection for tightening long pauses. false = never trim silence.
# VAD=true
# wav2vec2 CTC forced alignment for exact word boundaries at filler cuts. false = whisper-only search.
# ALIGNER=true
# Where the face, text and alignment models run: cpu, cuda (Linux, needs the onnxruntime CUDA provider plus CUDA 12 and cuDNN 9 in the image, which the published image does not carry), coreml (macOS) or dml (Windows). A provider that cannot load falls back to cpu with a warning; Settings → System and reelsaw machine show where each model landed. Measured on Apple silicon, CoreML was slower than the CPU for all three models, so cpu stays the default. The VAD always runs on the CPU. Values: cpu | cuda | coreml | dml. (cpu | cuda | coreml | dml)
# ONNX_EXECUTION_PROVIDER=cpu
# wav2vec2 model directory.
# ALIGN_MODEL_DIR=./models/wav2vec2-base-960h
# Silero VAD ONNX model.
# VAD_MODEL_PATH=./models/silero-vad.onnx
# PP-OCRv4 text detector ONNX model.
# TEXT_MODEL_PATH=./models/ppocrv4-det.onnx

# ---- Storage ----
# local (inside DATA_DIR) or s3. (local | s3)
STORAGE_DRIVER=local
# Directory for the local driver. Unset: DATA_DIR/storage.
# STORAGE_LOCAL_DIR=
# Bucket name. Required with STORAGE_DRIVER=s3.
# S3_BUCKET=
# Bucket region.
# S3_REGION=us-east-1
# Custom endpoint for MinIO, R2, B2 and similar. Empty for AWS.
# S3_ENDPOINT=
# Access key id.
# S3_ACCESS_KEY_ID=
# Secret access key.
# S3_SECRET_ACCESS_KEY=
# Path-style addressing; required for MinIO.
# S3_FORCE_PATH_STYLE=false
# Optional key prefix inside the bucket.
# S3_PREFIX=
# Serve clips from a public bucket or CDN at this base URL instead of presigned URLs.
# S3_PUBLIC_URL=
# Presigned URL lifetime in seconds (at most 604800, the 7-day SigV4 limit).
# S3_PRESIGN_EXPIRES=3600
# Delete audio, chunks and subtitle intermediates when a project finishes.
# CLEANUP_WORKDIR=true

# ---- Quotas, retention and history ----
# Changes (API mutations, MCP tool calls) an account may make per minute. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
# MAX_REQUESTS_PER_MINUTE=0
# Changes an account may make per hour. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
# MAX_REQUESTS_PER_HOUR=0
# Days a share link works unless the owner picks fewer (1-3650). Runtime setting: admins can change it under Settings → System without a restart.
# MEDIA_LINK_TTL_DAYS=90
# true lets owners make a share link that never expires (they can still revoke it). Hosted sets false. Runtime setting: admins can change it under Settings → System without a restart.
# MEDIA_LINK_ALLOW_NEVER=true
# Days a revoked or expired share link stays listed (so the owner can see why it stopped) before it is deleted. 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
# MEDIA_LINK_RETENTION_DAYS=30
# S3 only: answer a share link with a 302 to a presigned URL instead of streaming the object through the app. Off by default because schedulers and Instagram document only a direct public URL; turn on after checking yours follow redirects.
# MEDIA_LINKS_REDIRECT=false
# Webhook endpoints an account may add. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
# MAX_WEBHOOKS_PER_USER=10
# true lets webhook URLs point at LAN or loopback hosts (a self-hosted n8n next to Reelsaw), over http too. Off, they must be public https; every delivery is checked again and pinned to the checked address. Runtime setting: admins can change it under Settings → System without a restart.
# ALLOW_PRIVATE_WEBHOOK_URLS=false
# Days the webhook delivery log keeps a row (request, answer, attempts). 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
# WEBHOOK_DELIVERY_RETENTION_DAYS=14
# Webhook deliveries in flight per worker process (each waits at most 10 s for the receiver).
# WEBHOOK_CONCURRENCY=8
# Events a project page replays when it connects (progress ticks never replay); older ones load on request.
# EVENT_REPLAY_LIMIT=300
# Quota: projects per account. 0 = unlimited. Admins can override per user on the Users page. Runtime setting: admins can change it under Settings → System without a restart.
MAX_PROJECTS_PER_USER=0
# Quota: minutes of source video per account per day. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
MAX_SOURCE_MINUTES_PER_DAY=0
# Quota: new projects per account per hour. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
MAX_NEW_PROJECTS_PER_HOUR=0
# Quota: jobs a user's own requests may have queued or running at once (hosted: e.g. 12). Pipeline hand-offs are never refused and do not count. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
# MAX_LIVE_JOBS_PER_USER=0
# Quota: re-renders, hand-made clips and re-runs (re-analyze, refine) per account per hour. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
# MAX_RERENDERS_PER_HOUR=0
# Quota: sources + uploads + rendered clips + intros/outros kept per account, in MB; checked at upload and project creation. Deleted items count until they are deleted forever. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
# MAX_STORAGE_MB=0
# Quota: minutes of source video per account per period: the billing period when the account has a plan (ee), else the UTC calendar month. 0 = unlimited. Runtime setting: admins can change it under Settings → System without a restart.
MAX_SOURCE_MINUTES_PER_MONTH=0
# Burn a small text watermark into the clips of accounts that are not admins. A paid plan removes it; admins can switch it per user on the Users page (Limits). Runtime setting: admins can change it under Settings → System without a restart.
WATERMARK_NON_ADMINS=true
# The watermark text, shown under the logo. Runtime setting: admins can change it under Settings → System without a restart.
# WATERMARK_TEXT=reelsaw.com
# PNG composited above the watermark text (top-left under the platform top band, 18% of the frame width, 95% opacity). An unreadable file logs a warning and leaves the text watermark alone.
# WATERMARK_LOGO_PATH=./assets/watermark.png
# Delete stored sources older than this. Rows stay; Retry on the project fetches the source again, after which clips can be re-rendered (until then a render fails with a message saying so). 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
SOURCE_RETENTION_DAYS=0
# Delete rendered clips and thumbnails older than this, from the store and local disk. Rows stay; re-rendering a clip brings it back. 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
CLIP_RETENTION_DAYS=0
# Deleted projects and clips replaced by a re-analyze stay restorable this long (Deleted page), then their rows and files are purged. Storage still counts until then (or until the owner deletes them forever). 0 = keep forever. Runtime setting: admins can change it under Settings → System without a restart.
# DELETED_RETENTION_DAYS=7
# With STORAGE_DRIVER=s3, the copies of sources and rendered clips under DATA_DIR/projects are a cache of the bucket: the hourly sweep evicts the ones of finished projects idle this long (a job pulls them back when it needs them), and a job short of disk evicts the least recently used ones first before it gives up. 0 = keep them on the worker. Nothing to evict with the local store (scratch and store are one hardlinked file). Runtime setting: admins can change it under Settings → System without a restart.
# SCRATCH_CACHE_HOURS=24
# Prune project events after N days (each project keeps its created / run.started / done rows). 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
EVENT_RETENTION_DAYS=90
# Prune model-call usage rows after N days. 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
LLM_USAGE_RETENTION_DAYS=180
# Prune the admin event log after N days. 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
ADMIN_EVENT_RETENTION_DAYS=365
# Prune the decision log (users' accepts, rejects and edits, kept after their project is deleted so Reelsaw can learn from them) after N days. 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
DECISION_RETENTION_DAYS=0
# Drop the saved checkpoints of a finished project (the finding-moments windows a Retry reuses) after N days without change. 0 = keep. Runtime setting: admins can change it under Settings → System without a restart.
# STEP_RETENTION_DAYS=14

# ---- Enterprise edition and billing (hosted) ----
# Load the enterprise edition (apps/server/src/ee, its own licence): billing through Stripe, plans that set each account's limits. Off, nothing in that folder runs. See docs/specs/ee.md.
REELSAW_EE=false
# Stripe secret key (sk_live_… / sk_test_…). Required with REELSAW_EE.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint POST /api/billing/webhook (whsec_…). Required with REELSAW_EE.
STRIPE_WEBHOOK_SECRET=
# Enable Stripe Managed Payments (Stripe as merchant of record: it files sales tax and VAT) on every Checkout Session. The Stripe account must be approved for it first.
# STRIPE_MANAGED_PAYMENTS=false
# Development only: an origin that stands in for api.stripe.com (stripe-mock, or test/stripe-mock.ts). Never set in production.
# STRIPE_API_BASE=
# Days a past-due subscription keeps its plan after the first failed payment; then the account falls back to Free.
# BILLING_GRACE_DAYS=7

# ---- Resource governor and workers ----
# A running job with no progress event for this long is reported (log and UI) as stalled. Runtime setting: admins can change it under Settings → System without a restart.
# STALL_MINUTES=15
# On SIGTERM wait this long for running jobs to finish before exiting, so deploys stop interrupting renders. Compose kills the container at STOP_GRACE_PERIOD (default 330s): when you raise this above 300, set STOP_GRACE_PERIOD to at least SHUTDOWN_GRACE_SECONDS + 30s in .env. The app warns at boot when it is above 300.
# SHUTDOWN_GRACE_SECONDS=300
# Heavy steps wait while total CPU time is busier than this (measured, any OS).
# MAX_CPU_PERCENT=90
# Heavy steps wait while free memory is below this.
# MIN_FREE_MEM_MB=512
# Floor that must stay free. A job that also needs scratch checks the floor plus that scratch against free space net of what jobs in flight have already leased on the volume, and leases its own in the same step, so two jobs cannot both pass on the same bytes; short of disk it first evicts scratch copies the S3 store still has (SCRATCH_CACHE_HOURS), then waits for other jobs' leases to come back, or, short of real bytes, moves to another worker that has the room or fails the run when none does. A worker below the floor with nothing left to evict stops taking media jobs while another worker has the room, until it is 1 GB above the floor again (Settings → System → Workers shows "disk full"); a single box fails the job instead.
# MIN_FREE_DISK_MB=2048
# Longest a step waits for CPU, memory, or disk other jobs have leased but not written yet. A shortfall of real bytes does not wait: eviction, hand-off or failure.
# RESOURCE_WAIT_MAX_SECONDS=900

# ---- Logging, tracing and telemetry ----
# A level (trace..silent) optionally followed by per-module overrides, e.g. info,render=debug,http=warn. Change it without a restart with reelsaw log-level.
# LOG_LEVEL=info
# auto (pretty on a terminal, JSON otherwise), json or pretty. (auto | json | pretty)
# LOG_FORMAT=auto
# OpenTelemetry traces, logs and metrics over OTLP/HTTP. Independent of SENTRY_DSN — set OTEL_EXPORTER_OTLP_ENDPOINT (and HEADERS) explicitly. Logs are the pino lines that pass their level, sent to /v1/logs (Sentry accepts these). Prompt, transcript and address fields stay in the local log only. Sentry does not accept OTLP metrics; those go through SENTRY_DSN when metrics are left on. See the OTEL_* variables at the end.
# OTEL_ENABLED=false
# Sentry DSN. Set, the server reports every error or fatal log line that carries an error (5xx responses, unexpected MCP tool errors, a job's final failed attempt, jobs the reconciler gave up on, failed emails and billing syncs), tagged with the line's ids, and checks in the worker heartbeat, reconciler and billing reconcile as cron monitors; the web app reports render errors and unhandled rejections other than 4xx refusals (the DSN is public and handed to the browser). Does not configure the OTLP exporter. When OTEL is on, the endpoint is Sentry, and metrics are left on, Node runtime gauges and the application metrics (README, Metrics) are sent through this DSN, because Sentry does not ingest OTLP metrics. Unset, nothing is sent.
# SENTRY_DSN=
# Sentry environment tag. Default: production under NODE_ENV=production, else development.
# SENTRY_ENVIRONMENT=
# Share (0–1) of browser errors that send a Sentry session replay of the moments before the error. Replays mask all text and inputs and block all media; nothing is recorded for sessions without an error. 0 (default) loads no replay code.
# SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
# PostHog project key (public). Set, the server sends sign-ups, approvals, project created/done/failed/cancelled, clip done/failed, requested jobs, quota refusals, downloads and exports, MCP tool calls, billing and abuse-flag events (with the surface: web, api, mcp, cli), and the web app sends page views and a few product events; properties are ids, counts and names, and people are identified by user id, role and plan only (no email or name). Unset, nothing is sent.
# POSTHOG_KEY=
# PostHog ingestion host (https://eu.i.posthog.com for the EU cloud, or a self-hosted instance).
# POSTHOG_HOST=https://us.i.posthog.com
# Capture model calls: none, logs (one structured line per call: prompt, response, tokens, latency) or langfuse; comma-separate for several.
LLM_TRACE=logs
# Truncate captured prompts and responses to this many characters.
# LLM_TRACE_MAX_CHARS=4000
# Langfuse public key (checked at boot when LLM_TRACE includes langfuse).
# LANGFUSE_PUBLIC_KEY=
# Langfuse secret key.
# LANGFUSE_SECRET_KEY=
# Langfuse host.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Also write JSON lines here (daily files, 7 kept). Each process writes its own <name>.<worker id>.<date>.log next to this path, so scaled workers never prune each other. Survives container re-creation; reelsaw logs and issue reports read every such file.
# LOG_FILE=/data/logs/reelsaw.log

# ---- Media tools and downloads ----
# ffmpeg binary.
# FFMPEG_PATH=ffmpeg
# H.264 encoder for clips, intros/outros and previews. auto probes h264_nvenc (NVIDIA, container started with docker-compose.gpu.yml) then h264_videotoolbox (macOS, outside Docker) at boot and keeps libx264 otherwise; naming one makes boot fail if it cannot encode. A hardware encoder that fails mid-render is retried on libx264. Settings → System and reelsaw machine show the one in use and why. Values: auto | libx264 | h264_nvenc | h264_videotoolbox. (auto | libx264 | h264_nvenc | h264_videotoolbox)
# FFMPEG_ENCODER=auto
# ffprobe binary.
# FFPROBE_PATH=ffprobe
# yt-dlp binary.
# YTDLP_PATH=yt-dlp
# yt-dlp egress: one URL (http, https, socks5, socks5h), or a comma-separated pool [id=]<url-or-direct>[;priority=N][;concurrency=N]. priority is the operator ranking (higher is tried first) and never changes at runtime; a circuit breaker skips a candidate after consecutive faults, then the ranking applies again. direct uses this server's IP. {session} in a URL is replaced with a fresh id on every download so a residential gateway can pin that process to one IP and give the next download a different one (DataImpulse: sessid.{session} in the username; turn plan-wide sticky off). YouTube blocks many datacentre IPs. On a hosted or shared instance this is also where to enforce that downloads cannot reach private networks (SECURITY.md, "URL sources and your network"). reelsaw ytdlp-proxies shows the pool (never URLs). Example: pi=socks5h://100.64.1.10:1080;priority=20;concurrency=1,paid=http://user:pass@gate.example:7000;priority=1.
YTDLP_PROXY=
# Cookies file in Netscape format for yt-dlp.
YTDLP_COOKIES_FILE=
# Font family for burned-in captions; it must be installed where ffmpeg runs.
# CAPTION_FONT=DejaVu Sans

# ---- Docker Compose and OpenTelemetry (read outside config.ts) ----
# Database password used by both the db and app containers (compose only).
POSTGRES_PASSWORD=change-me
# Image the compose file runs (compose only).
# REELSAW_IMAGE=ghcr.io/osbytes/reelsaw:latest
# Speech model the Speaches container downloads. Systran/faster-whisper-small runs about real-time on a CPU; with a GPU use Systran/faster-whisper-medium (under 16 GB VRAM) or Systran/faster-whisper-large-v3 (the installer picks). Compose only.
# WHISPER_MODEL=Systran/faster-whisper-small
# Speaches image: ghcr.io/speaches-ai/speaches:latest-cuda with an NVIDIA GPU handed to the container by docker-compose.gpu.yml (COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml on Linux/macOS, ; instead of : on Windows; the installer picks it). Compose only.
# SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
# Compose maps this to RUN_WORKERS of the app container. false when only dedicated worker containers should process jobs.
# RUN_WORKERS_IN_APP=true
# OpenTelemetry service name (read by otel.ts).
# OTEL_SERVICE_NAME=reelsaw
# OTLP/HTTP collector base URL (the SDK appends /v1/traces). For Sentry, paste the OTLP base from Project Settings → Client Keys → OpenTelemetry (…/integration/otlp), not …/v1/traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Extra OTLP headers as key=url-encoded-value pairs. For Sentry: x-sentry-auth=sentry%20sentry_key%3D<public-key> (the public key from the DSN). Private collector example: authorization=Bearer%20xxx.
# OTEL_EXPORTER_OTLP_HEADERS=
# Export metrics as well as traces. A collector receives OTLP /v1/metrics. Sentry does not: with a Sentry OTLP endpoint and SENTRY_DSN set, the server sends Node runtime gauges and the application metrics (README, Metrics: pipeline stages per second of video, yt-dlp proxies, model calls) as Sentry Application Metrics instead. Set to false for traces only.
# OTEL_METRICS_ENABLED=true
# Fraction of traces to record, from 0 to 1. Default 1 (record all). The browser uses the same rate and starts before the first API call, so a page load and the server work it starts share a trace. A trace the browser does not record is not recorded on the server either. Leave OTEL_TRACES_SAMPLER unset; that standard variable overrides this on the server only.
# OTEL_TRACES_SAMPLE_RATE=1
# Metric export interval in milliseconds.
# OTEL_METRIC_EXPORT_INTERVAL=30000
# Diagnostic log level of the OpenTelemetry SDK itself.
# OTEL_LOG_LEVEL=
# <<< generated
