# Copy to .env and fill in. Restart after changes: docker compose up -d

# ---- required ----
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The URL people open in the browser
APP_URL=http://localhost:3000
# Database password (used by both the db and app containers)
POSTGRES_PASSWORD=change-me

# ---- image ----
# Which image to run (GHCR by default; Docker Hub mirrors may also be available)
# REELSAW_IMAGE=ghcr.io/osbytes/reelsaw:latest
# PORT=3000

# ---- AI models (provider:model) ----
# Language model that picks and scores clips:
#   openai:gpt-4o-mini | anthropic:claude-sonnet-4-5 | google:gemini-2.5-flash
#   groq:llama-3.3-70b-versatile | gateway:anthropic/claude-sonnet-4-5 | compat:<model> (OpenAI-compatible server)
AI_MODEL=openai:gpt-4o-mini
# Speech-to-text with word timestamps:
#   openai:whisper-1 | openai:gpt-4o-transcribe | deepgram:nova-3 | assemblyai:best | groq:whisper-large-v3-turbo
TRANSCRIPTION_MODEL=openai:whisper-1

# Provider keys: set the ones you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
AI_GATEWAY_API_KEY=

# ---- fully local (docker compose --profile local-ai up -d) ----
# AI_MODEL=compat:qwen2.5:14b
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1   # Ollama on the host (macOS); http://ollama:11434/v1 with --profile ollama
# OPENAI_COMPATIBLE_API_KEY=ollama
# TRANSCRIPTION_MODEL=openai:Systran/faster-whisper-small
# OPENAI_BASE_URL=http://speaches:8000/v1
# OPENAI_API_KEY=local
# WHISPER_MODEL=Systran/faster-whisper-small   # faster-whisper-large-v3 on a GPU

# ---- storage: local (inside the data volume) or s3 ----
STORAGE_DRIVER=local
# S3_BUCKET=reelsaw
# S3_REGION=us-east-1
# S3_ENDPOINT=                 # MinIO / R2 / B2; empty for AWS
# S3_FORCE_PATH_STYLE=true     # MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- behaviour ----
# open: anyone may sign up (default). approval: new accounts wait until you approve them in
# Settings → Users. closed: no sign-ups. The first account created is the admin.
SIGNUP_MODE=open

# Outgoing mail: none (default) | smtp | resend. Needed for approval notices, password reset and
# email verification; everything else works without it.
EMAIL_DRIVER=none
EMAIL_FROM=                    # "Reelsaw <no-reply@example.com>"
SMTP_URL=                      # smtps://user:pass@smtp.example.com:465
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=false
# Shown on the sign-up form when set
TERMS_URL=
PRIVACY_URL=
# RENDER_CONCURRENCY=auto      # renders in parallel: auto follows CPUs and free memory; a number pins it
MAX_UPLOAD_MB=4096
# MAX_CPU_PERCENT=90           # heavy steps wait while the machine is busier than this
# MIN_FREE_MEM_MB=512
# MIN_FREE_DISK_MB=2048

# ---- issue reports ----
# Records each model call (prompt, response, tokens) in the log so "Report an issue" can include it.
# Prompts contain transcript text; set to none if you'd rather not keep them.
LLM_TRACE=logs
# LLM_TRACE_MAX_CHARS=4000

# ---- Hosting many people (all optional; 0 = unlimited / off) ----
# Quotas per account; admins can override per user on the Users page
MAX_PROJECTS_PER_USER=0
MAX_SOURCE_MINUTES_PER_DAY=0
MAX_NEW_PROJECTS_PER_HOUR=0
# Delete stored sources / rendered clips after N days (rows stay; "fetch again" / re-render brings them back)
SOURCE_RETENTION_DAYS=0
CLIP_RETENTION_DAYS=0
# Prune history after N days (0 = keep). Events always keep each project's created / run.started / done rows.
EVENT_RETENTION_DAYS=90
LLM_USAGE_RETENTION_DAYS=180
ADMIN_EVENT_RETENTION_DAYS=365
# Bot protection on sign-up and sign-in: cloudflare-turnstile | google-recaptcha | hcaptcha
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# YouTube blocks datacentre IPs: route yt-dlp through a proxy and/or a cookies file (Netscape format)
YTDLP_PROXY=
YTDLP_COOKIES_FILE=
# MCP over OAuth 2.1 so claude.ai / Claude Desktop connectors sign in with the browser (API keys always work)
MCP_OAUTH=false
# Machine numbers in GET /api/health for anonymous callers (private networks only)
HEALTH_DETAILS=false
