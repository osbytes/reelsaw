 "segments": [
  {
   "text": "नमस्ते दोस्तों आज हम आपको पुरानी दिल्ली की सबसे मशहूर गलियों में ले चलेंगे यहाँ का खाना सौ साल से भी ज़्यादा पुराना है सबसे पहले हम चाँदनी",
   "start": 1.2,
   "end": 8.29
  },
  {
   "text": "चौक की उस दुकान पर जाएँगे",
   "start": 8.29,
   "end": 9.483
  },
  {
   "text": "जहाँ",
   "start": 10.023,
   "end": 10.28
  },
  {
   "text": "सुबह पाँच बजे से लाइन लगती है",
   "start": 10.8,
   "end": 12.183
  },
  {
   "text": "मालिक बताते हैं कि उनके दादाजी ने यह दुकान एक छोटे से ठेले से शुरू की थी आज भी वही नुस्खा इस्तेमाल होता है और कोई मशीन नहीं",
   "start": 13.103,
   "end": 18.885
  },
  {
   "text": "लगती आप देख सकते हैं कि आटा हाथ से गूँधा जा रहा है मुझे सच में नहीं पता था कि इतनी भीड़ होगी चलिए अब पहला निवाला चखते",
   "start": 18.885,
   "end": 24.739
  },
  {
   "text": "हैं वाह यह तो बिल्कुल वैसा ही है जैसा मेरी नानी बनाया करती थीं मसाला तेज़ है लेकिन जीभ नहीं जलती अगर आप पहली बार आ रहे हैं",
   "start": 24.739,
   "end": 31.177
  },
  {
   "text": "तो दोपहर से पहले आइए क्योंकि उसके बाद सब खत्म हो जाता है अब हम थोड़ा आगे चलते हैं और जलेबी वाले के पास रुकते हैं इनकी",
   "start": 31.177,
   "end": 36.374
  },
  {
   "text": "जलेबी देसी घी में बनती है और इसलिए इसका रंग थोड़ा गहरा होता है बहुत से लोग पूछते हैं",
   "start": 37.134,
   "end": 41.841
  },
  {
   "text": "कि क्या यह सेहत के लिए ठीक है",
   "start": 42.401,
   "end": 43.672
  },
  {
   "text": "मेरा जवाब है कि कभी कभी खाने में कोई बुराई नहीं है",
   "start": 44.352,
   "end": 46.594
  },
  {
   "text": "असली बात यह है कि यहाँ हर चीज़ ताज़ा बनती है यहाँ के लोग बहुत मिलनसार हैं और हर कोई आपको अपनी कहानी सुनाना चाहता है एक बुज़ुर्ग",
   "start": 47.334,
   "end": 53.419
  },
  {
   "text": "ने मुझे बताया कि वह पचास साल से रोज़ यहीं चाय पीने आते हैं सोचिए",
   "start": 53.419,
   "end": 56.421
  },
  {
   "text": "पचास साल एक ही दुकान पर यही तो इस जगह की खूबसूरती है अब बात करते हैं पैसों की क्योंकि यह सवाल आप सब पूछते हैं पूरे दिन",
   "start": 57.001,
   "end": 63.621
  },
  {
   "text": "का खाना दो सौ रुपये में आराम से हो जाता है मेट्रो से",
   "start": 63.621,
   "end": 66.355
  },
  {
   "text": "आइए क्योंकि गाड़ी खड़ी करने की जगह मिलना लगभग नामुमकिन है चाँदनी चौक स्टेशन से बाहर निकलते ही आप बाज़ार में होते हैं",
   "start": 66.935,
   "end": 72.756
  },
  {
   "text": "गर्मियों में पानी की बोतल ज़रूर साथ रखिए और",
   "start": 73.276,
   "end": 75.224
  },
  {
   "text": "हाँ अपना फ़ोन संभाल कर रखिए क्योंकि भीड़ में ध्यान भटक जाता है अगला पड़ाव है परांठे वाली गली जिसका नाम आपने ज़रूर सुना होगा यहाँ बीस से",
   "start": 75.984,
   "end": 82.952
  },
  {
   "text": "ज़्यादा तरह के परांठे मिलते हैं मैंने आलू का और पनीर का मँगवाया है साथ में तीन तरह की चटनी और आलू की सब्ज़ी आती है ईमानदारी से",
   "start": 83.412,
   "end": 89.774
  },
  {
   "text": "कहूँ तो पनीर वाला",
   "start": 89.774,
   "end": 90.551
  },
  {
   "text": "मुझे ज़्यादा पसंद आया आलू वाला थोड़ा भारी लगा लेकिन स्वाद में कोई कमी नहीं थी दुकानदार ने बताया कि सर्दियों में",
   "start": 92.491,
   "end": 97.975
  },
  {
   "text": "यहाँ और भी ज़्यादा लोग आते हैं शाम होते होते",
   "start": 98.715,
   "end": 101.886
  },
  {
   "text": "गलियों में रोशनी जगमगाने लगती है उस वक्त का माहौल बिल्कुल अलग होता है अगर आपके पास समय हो तो जामा मस्जिद की सीढ़ियों पर बैठकर सूरज ढलते",
   "start": 102.646,
   "end": 109.787
  },
  {
   "text": "देखिए वहाँ से पूरा पुराना शहर दिखता है",
   "start": 109.787,
   "end": 111.495
  },
  {
   "text": "मेरे लिए यह आज का सबसे यादगार पल था तो दोस्तों यह था हमारा पुरानी दिल्ली का सफ़र अगर आपको यह वीडियो अच्छा लगा तो बताइए कि अगली",
   "start": 112.175,
   "end": 118.712
  },
  {
   "text": "बार हम कहाँ चलें कमेंट में अपनी पसंदीदा जगह का नाम ज़रूर लिखिए मिलते हैं अगले वीडियो में तब तक के लिए खूब घूमिए और खूब खाइए",
   "start": 119.032,
   "end": 125.013
  }
 ],
